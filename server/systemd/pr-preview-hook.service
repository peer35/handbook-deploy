[Unit]
Description=GitHub webhook receiver for Quarto PR previews
After=network-online.target
Wants=network-online.target

[Service]
User=preview
Group=preview
EnvironmentFile=/etc/pr-preview/config.env
Environment=HOME=/srv/pr-preview/home
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/pr-preview/pr_preview_hook.py
Restart=on-failure
RestartSec=5

# Hardening: builds run PR content, so keep them boxed in
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths=/srv/pr-preview /var/www/previews

[Install]
WantedBy=multi-user.target
