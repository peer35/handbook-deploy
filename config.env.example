# config.env, passed to the container by the quadlet (podman --env-file).
# Keep it out of git; owned by the preview user, mode 600 (setup.sh does that).

# Repository to build previews for, and where previews are served
GITHUB_REPO=peer35/open-handbook-test
PREVIEW_BASE_URL=https://PREVIEW_HOST

# Same value as the "Secret" in the GitHub webhook / GitHub App settings
WEBHOOK_SECRET=CHANGE_ME

# Authentication, option 1: fine-grained personal access token for GITHUB_REPO with
#   Pull requests: read & write, Commit statuses: read & write (Metadata: read is implied)
GITHUB_TOKEN=

# Authentication, option 2: GitHub App (leave GITHUB_TOKEN empty).
# Put the private key in ./secrets/app.pem (owned by the preview user, mode 600).
#GITHUB_APP_ID=
#GITHUB_APP_KEY_FILE=/secrets/app.pem

# Command run in the checkout before `quarto render` (empty to disable)
PRE_RENDER=[ ! -f .github/scripts/fix-timestamps ] || bash .github/scripts/fix-timestamps

# Optional settings (defaults shown)
#REPO_URL=https://github.com/peer35/open-handbook-test.git
#OUTPUT_DIR=_site
#MAX_PARALLEL=1
#BUILD_TIMEOUT=1800
#RECONCILE_INTERVAL=3600
#LOGS_KEEP=10
#CLOSED_LOG_DAYS=14
#ALLOWED_ASSOCIATIONS=OWNER,MEMBER,COLLABORATOR
#THREADS=8
#LOG_LEVEL=INFO
