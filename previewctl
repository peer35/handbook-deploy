#!/usr/bin/env bash
# Manage the rootless pr-preview container, which runs as the "preview" user.
# Run as root (it switches to that user) or as the preview user itself.
#
#   previewctl build              build the image (Quarto version: QUARTO_VERSION in config.env)
#   previewctl test               build the test stage, which runs the test suite
#   previewctl start|stop|restart|status
#   previewctl logs [-f] [...]    journal of the service (extra args go to journalctl)
#   previewctl reload             pick up an edited quadlet file
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
user=${PREVIEW_USER:-preview}
uid=$(id -u "$user")
unit=pr-preview.service

as_user() {
  local env=(XDG_RUNTIME_DIR="/run/user/$uid" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus")
  if [ "$(id -u)" = "$uid" ]; then
    env "${env[@]}" "$@"
  else
    (cd / && sudo -u "$user" -H env "${env[@]}" "$@")
  fi
}

# Last value of a setting in config.env (literal, like podman --env-file reads it)
setting() {
  [ ! -r "$here/config.env" ] || sed -n "s/^$1=//p" "$here/config.env" | tail -n 1
}

# podman pull uses these variables itself, and podman build hands them to the RUN steps
# without storing them in the image. Both spellings: apt and curl only read http_proxy.
build_image() {
  local https http no name quarto env=() args=()
  https=$(setting HTTPS_PROXY)
  http=$(setting HTTP_PROXY)
  no=$(setting NO_PROXY)
  http=${http:-$https}
  for name in HTTPS_PROXY https_proxy; do [ -z "$https" ] || env+=("$name=$https"); done
  for name in HTTP_PROXY http_proxy; do [ -z "$http" ] || env+=("$name=$http"); done
  for name in NO_PROXY no_proxy; do [ -z "$no" ] || env+=("$name=$no"); done
  # Without a setting, the default in Containerfile applies
  quarto=${QUARTO_VERSION:-$(setting QUARTO_VERSION)}
  [ -z "$quarto" ] || args+=(--build-arg "QUARTO_VERSION=$quarto")
  as_user env "${env[@]}" podman build "${args[@]}" "$@"
}

cmd=${1:-}
shift || true
case $cmd in
  build)
    build_image --target app -t localhost/pr-preview:latest "$here"
    as_user podman image prune -f >/dev/null
    ;;
  test)
    build_image --target test "$here"
    ;;
  start | stop | restart | status)
    as_user systemctl --user "$cmd" "$unit"
    ;;
  reload)
    as_user systemctl --user daemon-reload
    ;;
  logs)
    if [ "$(id -u)" = 0 ]; then
      journalctl "_SYSTEMD_USER_UNIT=$unit" "_UID=$uid" "$@"
    else
      as_user journalctl --user -u "$unit" "$@"
    fi
    ;;
  *)
    sed -n '2,10s/^# \{0,1\}//p' "$0"
    exit 1
    ;;
esac
